SECRET_KEY=
MAIL_USERNAME=
MAIL_PASSWORD=
DATABASE_URL=
# FASE3-S1: clave Fernet para cifrar credenciales de canales.
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=
# Client Secret de la app en Tiendanube Partners. NUNCA commitear el valor.
TIENDANUBE_CLIENT_SECRET=
# App ID de Tiendanube. No es secreto; si falta se usa 40970.
TIENDANUBE_APP_ID=
# FASE-MP-S1: aplicacion de Mercado Pago Developers que autoriza las DOS
# cuentas (la de Roman y la de Nachi). El Client ID no es secreto pero tampoco
# tiene default: sin el, conectar falla diciendolo.
MERCADOPAGO_CLIENT_ID=
# NUNCA commitear el valor.
MERCADOPAGO_CLIENT_SECRET=
# Tiene que ser identico al Redirect URI cargado en el panel de Mercado Pago.
# Ej: https://<tu-app>.onrender.com/integraciones/mercadopago/callback
MERCADOPAGO_REDIRECT_URI=
